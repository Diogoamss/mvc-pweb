<%- include('../partials-head') %>
<h1><%= titulo %></h1>

<form method="GET" action="/produtos" class="busca">
  <input type="text" name="busca" placeholder="Pesquisar por nome" value="<%= busca %>">
  <button>Buscar</button>
  <% if (busca || typeof categoriaAtual !== 'undefined') { %><a href="/produtos">Limpar</a><% } %>
</form>

<table>
  <thead><tr><th>ID</th><th>Nome</th><th>Preço</th><th>Qtd.</th><th>Categoria</th><th>Ações</th></tr></thead>
  <tbody>
  <% produtos.forEach(p => { %>
    <tr>
      <td><%= p.id %></td>
      <td><%= p.nome %></td>
      <td>R$ <%= p.preco.toFixed(2) %></td>
      <td><%= p.quantidade %></td>
      <td>
        <% if (p.categoria) { %>
          <a href="/produtos/categoria/<%= p.categoria.id %>"><%= p.categoria.nome %></a>
        <% } else { %>—<% } %>
      </td>
      <td>
        <a href="/produtos/<%= p.id %>/editar">Editar</a>
        <form method="POST" action="/produtos/<%= p.id %>/excluir" style="display:inline"
              onsubmit="return confirm('Excluir este produto?')">
          <button class="link">Excluir</button>
        </form>
      </td>
    </tr>
  <% }) %>
  <% if (produtos.length === 0) { %><tr><td colspan="6">Nenhum produto encontrado.</td></tr><% } %>
  </tbody>
</table>
<%- include('../partials-foot') %>
